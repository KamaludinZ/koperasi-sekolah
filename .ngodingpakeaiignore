# .ngodingpakeaiignore — extra paths to keep out of NgodingPakeAI sync.
# Uses .gitignore syntax. Secrets, node_modules, build output and .env files
# are ALWAYS blocked by the CLI regardless of what is listed here.

# Examples:
# docs/internal/
# *.snap
# fixtures/

# Artefak Laravel hasil generate (sudah di-ignore oleh .gitignore bertingkat):
# Blade terkompilasi, cache paket/layanan, cache facade, file unggahan & struk PDF.
storage/framework/
storage/app/
storage/logs/
bootstrap/cache/
