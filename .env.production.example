# ===================================================================================================
# Contoh konfigurasi PRODUCTION — Koperasi Sekolah. Panduan lengkap: docs/deploy.md
#
# • Docker Compose (VPS)   : salin ke `.env` di sebelah docker-compose.yml.
# • Coolify                 : salin isinya ke tab "Environment Variables" (tanpa komentar).
# • Hosting biasa / cPanel  : salin ke `.env` di folder aplikasi (bukan di public_html).
#
# JANGAN commit berkas berisi nilai asli. Simpan APP_KEY & DB_PASSWORD di pengelola sandi —
# APP_KEY yang hilang/berganti membuat sesi, data terenkripsi, dan rantai audit pinjaman tidak terbaca.
# ===================================================================================================

APP_NAME="Koperasi Sekolah"
APP_ENV=production
APP_DEBUG=false
# Buat sekali: echo "base64:$(openssl rand -base64 32)"   atau   php artisan key:generate --show
APP_KEY=
# Alamat publik lengkap dengan https://, tanpa garis miring di akhir.
APP_URL=https://koperasi.sekolah.sch.id
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Docker: stderr (log tampil di Coolify/`docker compose logs`). Hosting biasa: daily (storage/logs, 14 hari).
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

# PostgreSQL (wajib di production). Docker Compose: DB_HOST=db. Coolify dengan database terpisah:
# isi host internal database Coolify. Hosting biasa: biasanya 127.0.0.1 / localhost. Lihat docs/database-postgresql.md
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=koperasi_sekolah
DB_USERNAME=koperasi
# Password acak yang kuat: openssl rand -base64 24
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Batas menganggur sesi petugas (menit) biasanya diatur Admin di Pengaturan → Keamanan & retensi.
# Isi hanya untuk menimpanya dari server (0 = nonaktif):
# KOPERASI_IDLE_MINUTES=60

CACHE_STORE=database
QUEUE_CONNECTION=database
# Lebih lama dari job terlama (cadangan/uji pemulihan 900 dtk) agar job tidak dijalankan ganda.
DB_QUEUE_RETRY_AFTER=960
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# HTTPS dipaksa + HSTS. TLS diterminasi proxy (Traefik Coolify / Caddy / Nginx / Cloudflare).
FORCE_HTTPS=true
# Proxy tepercaya: "*" bila aplikasi hanya bisa dijangkau lewat proxy (Docker/Coolify).
# Hosting biasa tanpa proxy: kosongkan. Di belakang Cloudflare: isi "*" atau daftar IP Cloudflare.
TRUSTED_PROXIES=*

# Cadangan data otomatis (zip berisi database.json + pg_dump + logo/QRIS) di storage/app/private.
KOPERASI_BACKUP_ENABLED=true
KOPERASI_BACKUP_TIME=23:00
KOPERASI_BACKUP_KEEP=14
# Butuh program pg_dump (sudah ada di image Docker). Hosting tanpa pg_dump: false (database.json tetap dibuat).
KOPERASI_BACKUP_PG_DUMP=true
KOPERASI_PINJAMAN_TOLERANSI_HARI=0

# Hosting tanpa pekerja antrean permanen (shared hosting/cPanel): true → antrean diproses lewat cron schedule:run.
# Docker/VPS dengan supervisord: false.
KOPERASI_QUEUE_VIA_CRON=false

# --- Khusus Docker (diabaikan di hosting biasa) ---
# Jumlah proses pekerja antrean & php-fpm di kontainer, batas memori PHP, migrasi otomatis saat start.
QUEUE_WORKERS=1
PHP_FPM_MAX_CHILDREN=20
PHP_MEMORY_LIMIT=256M
RUN_MIGRATIONS=true
# docker-compose.vps.yml: port host yang diteruskan reverse proxy.
APP_BIND=127.0.0.1
APP_PORT=8080
